<span class='product-card__stars'>
    <span class='product-card__stars__star' style='--star-color:[[+rating_simple_percent:ge=`20`:then=`#ffab1d`:else=`#d7dbe3`]]'></span>
    <span class='product-card__stars__star' style='--star-color:[[+rating_simple_percent:ge=`40`:then=`#ffab1d`:else=`#d7dbe3`]]'></span>
    <span class='product-card__stars__star' style='--star-color:[[+rating_simple_percent:ge=`60`:then=`#ffab1d`:else=`#d7dbe3`]]'></span>
    <span class='product-card__stars__star' style='--star-color:[[+rating_simple_percent:ge=`80`:then=`#ffab1d`:else=`#d7dbe3`]]'></span>
    <span class='product-card__stars__star' style='--star-color:[[+rating_simple_percent:ge=`100`:then=`#ffab1d`:else=`#d7dbe3`]]'></span>
</span>
