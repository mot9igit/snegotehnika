<span class="product-card__stars">
    <span class="product-card__stars__star" style="--star-color:[[+current_rating:ge=`0.5`:then=`#ffab1d`:else=`#d7dbe3`]]"></span>
    <span class="product-card__stars__star" style="--star-color:[[+current_rating:ge=`1.5`:then=`#ffab1d`:else=`#d7dbe3`]]"></span>
    <span class="product-card__stars__star" style="--star-color:[[+current_rating:ge=`2.5`:then=`#ffab1d`:else=`#d7dbe3`]]"></span>
    <span class="product-card__stars__star" style="--star-color:[[+current_rating:ge=`3.5`:then=`#ffab1d`:else=`#d7dbe3`]]"></span>
    <span class="product-card__stars__star" style="--star-color:[[+current_rating:ge=`4.5`:then=`#ffab1d`:else=`#d7dbe3`]]"></span>
</span>
