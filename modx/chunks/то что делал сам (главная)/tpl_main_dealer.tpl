<div class="dealer">
        <div class="dart-container">
          <img src="/assets/templates/snegotehnika/img/mainPage/dealer__img__mobile.png" alt="" class="dealer__img__mobile">
          <div class="dealer__inner">
            <h3 class="dealer__title">станьте  дилером в своем городе</h3>
            <p class="dealer__suptitle">Оставляйте номер, руководитель перезвонит и расскажет про все условия сотрудничества</p>
            <div class="dealer__buttons">
              <a class="dealer__button dealer__button--transparent" href="#">
                подробнее о дилерской программе
                <svg class="button__icon">
                  <use xlink:href="#buttonArrow"></use>
                </svg>
              </a>
              <a class="dealer__button" href="#">
                отправить запрос на звонок
                <svg class="button__icon">
                  <use xlink:href="#buttonArrow"></use>
                </svg>
              </a>
            </div>
            <div class="dealer__buttons__mobile">
              <form action="/">
                <input 
                type="tel"
                class="dealer__input"
                name="phone"
                placeholder="Ваш телефон"
                autocomplete="tel"
                pattern="[+]?[0-9\s\-\(\)]+"
                required
                >
                <button type="submit" class="dealer__button">
                  запрос на звонок
                  <svg class="button__icon">
                    <use xlink:href="#buttonArrow"></use>
                  </svg>
                </button>
                <input type="checkbox" id="privacy__dealer" name="approval" required>
                <label for="privacy__dealer" class="dealer__approval">
                    <span class="check-circle"></span>
                    <div>нажимая на кнопку, я соглашаюсь с <a href="#">политикой о конфиденциальности</a></div>
                </label>
              </form>
            </div>
          </div>
        </div>
      </div>