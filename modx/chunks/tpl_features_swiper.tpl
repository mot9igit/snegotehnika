                        </button>
                        {/if}
                        <button type="button" class="product-card__features__info" data-modal-open="modal-video-info" data-video-info="{$slide.info}" data-modal-video-title="{$slide.caption|escape}" data-modal-video-pros="{$slide.pros_json|escape}">
                            {$slide.caption|escape}
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="offers__item__icon">
                                <rect width="24" height="24" rx="6" fill="currentColor"/>
                                <path d="M18 12.8571H12.8571V18H11.1429V12.8571H6V11.1429H11.1429V6H12.8571V11.1429H18V12.8571Z" fill="white"/>
                            </svg>
                        </button>
                    </div>
                </div>
            {/foreach}
        </div>
        <div class="scrollbar scrollbar--features" data-scrollbar="{$name}"></div>
    </div>
</div>
